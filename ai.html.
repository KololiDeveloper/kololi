<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AI helpers - Kololi</title>
<style>html body{padding-top:0!important}#kgs{display:none!important}
body{font-family:Roboto,Arial,sans-serif;margin:0;background:#f4f9f8;color:#1f2d2b}
.top{background:linear-gradient(135deg,#4cb97a,#2f9fb4);padding:18px 14px;color:#fff}
.top h2{margin:0 0 4px}.top p{margin:0;font-size:14px;opacity:.9}
.box{margin:14px;background:#fff;border-radius:16px;padding:14px;box-shadow:0 2px 10px rgba(20,60,50,.1)}
.box select,.box textarea{width:100%;box-sizing:border-box;border:1px solid #d5e6e1;border-radius:12px;padding:12px;font-size:16px;font-family:inherit;margin-bottom:10px;background:#fbfdfc}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid button{padding:14px 8px;border:0;border-radius:12px;color:#fff;font-weight:600;font-size:15px}
.b1{background:#4c7fd0}.b2{background:#2fa37a}.b3{background:#8e6fd8}.b4{background:#2f9fb4}
#msg{margin:0 14px 14px;color:#2f7d4f;font-weight:600}
.note{margin:0 14px 14px;color:#5b6b68;font-size:13px}
html.kdark .box{background:#182a26;color:#e6f2ee}html.kdark .box select,html.kdark .box textarea{background:#122320;color:#e6f2ee;border-color:#2b4a43}</style></head><body>
<div class="top"><h2>AI helpers</h2><p>Pick a task, type your question, then choose an AI</p></div>
<div class="box">
<select id="t"><option value="explain">Explain it</option><option value="summ">Summarize it</option><option value="quiz">Quiz me</option><option value="essay">Essay outline</option></select>
<textarea id="q" rows="4" placeholder="Type your topic or question"></textarea>
<div class="grid"><button class="b1" onclick="go('gem')">Gemini</button><button class="b2" onclick="go('gpt')">ChatGPT</button><button class="b3" onclick="go('meta')">Meta AI</button><button class="b4" onclick="go('cop')">Copilot</button></div>
</div>
<p id="msg"></p>
<p class="note">Your question is copied, then the AI's website opens. Paste it into the chat. AI can make mistakes, so check facts and quotes against your course texts, and don't type personal information.</p>
<script>
const $=id=>document.getElementById(id);
const T={explain:"Explain this clearly for a first-year university student of English and Literature in Kenya, in short paragraphs. Say when you are unsure and never invent quotes: ",summ:"Summarize this in 5 bullet points and say what you are unsure about: ",quiz:"Make 5 practice questions with answers on this topic, and mark any answer you are not fully sure of: ",essay:"Give me an essay outline (introduction, 3 body points, conclusion) for this question. Do not invent quotes: "};
const SITES={gem:"https://gemini.google.com/app",gpt:"https://chatgpt.com/?q=",meta:"https://meta.ai",cop:"https://copilot.microsoft.com"};
async function copy(t){try{await navigator.clipboard.writeText(t);return true}catch(e){const a=document.createElement("textarea");a.value=t;document.body.appendChild(a);a.select();let ok=false;try{ok=document.execCommand("copy")}catch(x){}a.remove();return ok}}
async function go(k){const q=$("q").value.trim();if(!q){$("msg").textContent="Type your question first.";return}
const t=T[$("t").value]+q;const ok=await copy(t);let u=SITES[k];if(k==="gpt")u+=encodeURIComponent(t);
$("msg").textContent=ok?"Copied. Paste it into the chat that opens.":"Could not copy. Copy your question yourself, then paste it in the chat.";
window.open(u,"_blank")}
</script>
<script src="/nav.js"></script>
</body></html>
